# ==============================================================================
# SELOASA - Subdirectorio de Blog y Noticias
# ==============================================================================

# Deshabilitar MultiViews para prevenir que Apache intercepte slugs antes de mod_rewrite
Options -MultiViews -Indexes
Options +FollowSymLinks

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /blog/

    # Si el archivo o directorio existe físicamente, servirlo directamente
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Redirigir cualquier slug /blog/articulo/mi-slug a articulo.html?id=mi-slug
    RewriteRule ^articulo/([^/]+)/?$ articulo.html?id=$1 [QSA,L]

    # Redirigir cualquier slug /blog/mi-slug a articulo.html?id=mi-slug
    RewriteRule ^([^/]+)/?$ articulo.html?id=$1 [QSA,L]
</IfModule>
