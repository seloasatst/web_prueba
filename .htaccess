# Deshabilitar listado de directorios y negociación
Options -Indexes -MultiViews

DirectoryIndex index.html index.php

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

# Cabeceras de Seguridad HTTP
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header unset X-Powered-By
</IfModule>

# Bloquear acceso a archivos sensibles y de configuración
<FilesMatch "^(\.env|\.git|\.vscode|composer\.(json|lock)|package(-lock)?\.json|.*\.log|.*\.sql)$">
    Require all denied
</FilesMatch>

# Bloquear acceso a directorios de almacenamiento interno
RedirectMatch 403 ^/shipping/php/(storage|logs)/.*$

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Links Bonitos para Artículos de Blog:
    RewriteRule ^blog/articulo/([a-zA-Z0-9_\-]+)/?$ blog/articulo.html?id=$1 [QSA,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^blog/([a-zA-Z0-9_\-]+)/?$ blog/articulo.html?id=$1 [QSA,L]

    # 2. Rutas limpias de Administración (sin extensión .html):
    RewriteRule ^admin/login/?$ admin/login/index.html [QSA,L]
    RewriteRule ^admin/dashboard/?$ admin/dashboard.html [QSA,L]
    RewriteRule ^admin/noticias/?$ admin/dashboard.html [R=301,L]

    # 3. Permitir URLs limpias sin extensión .html (ej: /admin/editor -> /admin/editor.html)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.*)$ $1.html [L]

    # 4. Permitir archivos y carpetas reales existentes
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
</IfModule>

ErrorDocument 404 /404/

